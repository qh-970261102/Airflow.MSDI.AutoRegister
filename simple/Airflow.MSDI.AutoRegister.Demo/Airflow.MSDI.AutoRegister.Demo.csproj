<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <!-- 源生成器输出落盘:每次编译(生成器运行)都会全量重写 Generated/ 下的 .g.cs -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(MSBuildProjectDirectory)/Generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- 引用生成器:既作为 Analyzer 运行源生成,又提供编译期属性类型 -->
    <ProjectReference Include="..\..\src\Airflow.MSDI.AutoRegister\Airflow.MSDI.AutoRegister.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="true" />
  </ItemGroup>

  <ItemGroup>
    <!-- 落盘的生成文件仅供查看/参考,不参与编译(生成器已内存注入;再编译会重复定义) -->
    <Compile Remove="Generated/**/*.cs" />
    <None Include="Generated/**/*.cs" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- 运行时容器实现(Demo 用现代版本;生成器本身只依赖 Abstractions 1.0.0) -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
  </ItemGroup>

</Project>
